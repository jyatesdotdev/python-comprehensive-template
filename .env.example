# Project Settings
PROJECT_NAME="Python Template"
VERSION="0.1.0"
DESCRIPTION="A comprehensive Python project template."

# Database
DATABASE_URL="sqlite+aiosqlite:///./test.db"
# Set to true to log every SQL statement (useful for debugging, noisy otherwise)
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# CORS: JSON list. Code sets allow_credentials=False while this is ["*"].
CORS_ORIGINS=["*"]

# SSE demo stream length (finite so tests/transports terminate)
SSE_MAX_EVENTS=100

# Auth POC — override in any non-local environment
API_KEY=default-dev-key
API_KEY_NAME=X-API-KEY

# CLI default when talking to a running API
API_BASE_URL=http://localhost:8000
